[sub_resource type="Resource" id=1]
script = ExtResource( 5 )
histoire = "Marion, a noble and valiant female knight, carries the weight of honor and chivalry upon her shoulders. Born into a prestigious lineage of warriors, Marion was raised with a strict code of conduct and an unwavering dedication to justice. Clad in gleaming armor and wielding her mighty sword, she journeys through the land, upholding the virtues of bravery, compassion, and righteousness. Marion's noble origins and unyielding resolve grant her a commanding presence on the battlefield, where she leads her comrades in the face of adversity. Though her role may be prominent in the realm's legends, her unwavering commitment to protect the innocent and fight for what is right fuels her noble spirit and shapes her legacy as a beacon of hope in a world longing for heroes."
genre = "women"
temperament = "Calm
"
age = "25"
lieu_naissance = "volcano village"

